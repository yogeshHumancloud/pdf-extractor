{
  "name": "Indian Income Tax Return (ITR-1) Extractor",
  "version": "1.0.0",
  "description": "Rules to extract data from ITR-1 acknowledgement forms",
  "rules": {
    "acknowledgement_number": {
      "pattern": "Acknowledgement Number:(\\d+)",
      "type": "regex",
      "group": 1,
      "description": "Unique acknowledgement number for the ITR filing",
      "coordinates": {
        "page": 1,
        "x": 28.33,
        "y": 812,
        "width": 251.67,
        "height": 9.6
      }
    },
    "filing_date": {
      "pattern": "Date of filing\\s*:\\s*([\\d]{2}-[A-Za-z]{3}-[\\d]{4})",
      "type": "regex",
      "group": 1,
      "description": "Date when the ITR was filed",
      "coordinates": {
        "page": 1,
        "x": 417.3,
        "y": 812.03,
        "width": 150.5,
        "height": 9.6
      }
    },
    "assessment_year": {
      "pattern": "Assessment\\s+Year\\s+([\\d]{4}-[\\d]{2})",
      "type": "regex",
      "group": 1,
      "description": "Assessment year for the tax return",
      "coordinates": {
        "page": 1,
        "x": 495.8,
        "y": 779.7,
        "width": 57.96,
        "height": 9.6
      }
    },
    "pan": {
      "pattern": "PAN[\\s\\n]+([A-Z]{5,6}\\d{4}[A-Z])",
      "type": "regex",
      "group": 1,
      "description": "Permanent Account Number",
      "coordinates": {
        "page": 1,
        "x": 35.82,
        "y": 724.88,
        "width": 16.09,
        "height": 7.87
      }
    },
    "name": {
      "pattern": "Name([A-Za-z\\s]+?)Address",
      "type": "regex",
      "group": 1,
      "description": "Taxpayer's name",
      "coordinates": {
        "page": 1,
        "x": 35.82,
        "y": 700.69,
        "width": 23.33,
        "height": 7.87
      }
    },
    "address": {
      "pattern": "Address([A-Za-z0-9,\\s]+?)Status",
      "type": "regex",
      "group": 1,
      "description": "Taxpayer's address",
      "coordinates": {
        "page": 1,
        "x": 35.82,
        "y": 676.5,
        "width": 31.83,
        "height": 7.87
      }
    },
    "status": {
      "pattern": "Status\\s*(Individual|HUF|Firm|Company)",
      "type": "regex",
      "group": 1,
      "description": "Tax filing status",
      "coordinates": {
        "page": 1,
        "x": 35.82,
        "y": 652.31,
        "width": 25.23,
        "height": 7.87
      }
    },
    "form_number": {
      "pattern": "Form Number\\s*(ITR-\\d+)",
      "type": "regex",
      "group": 1,
      "description": "ITR form type",
      "coordinates": {
        "page": 1,
        "x": 56.22,
        "y": 768.57,
        "width": 406.74,
        "height": 7.87
      }
    },
    "efiling_ack_number": {
      "pattern": "e-Filing Acknowledgement Number\\s*(\\d+)",
      "type": "regex",
      "group": 1,
      "description": "E-filing acknowledgement number",
      "coordinates": {
        "page": 1,
        "x": 304.22,
        "y": 628.12,
        "width": 138.96,
        "height": 7.87
      }
    },
    "filed_under_section": {
      "pattern": "Filed u/s\\s*([\\d\\(\\)\\-A-Za-z\\s]+?)e-Filing",
      "type": "regex",
      "group": 1,
      "description": "Section under which return was filed",
      "coordinates": {
        "page": 1,
        "x": 224.53,
        "y": 759.57,
        "width": 70.11,
        "height": 7.87
      }
    },
    "current_year_loss": {
      "pattern": "Current Year business loss, if any\\s*1\\s*(\\d+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Current year business loss",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 603.35,
        "width": 132.49,
        "height": 7.87
      }
    },
    "total_income": {
      "pattern": "Total Income\\s*1A\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Total income declared",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 579.16,
        "width": 51.5,
        "height": 7.87
      }
    },
    "book_profit": {
      "pattern": "Book Profit under MAT.*?\\s*2\\s*(\\d+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Book profit under MAT",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 554.97,
        "width": 161.29,
        "height": 7.87
      }
    },
    "adjusted_income": {
      "pattern": "Adjusted Total Income under AMT.*?\\s*3\\s*(\\d+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Adjusted total income under AMT",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 530.78,
        "width": 206.92,
        "height": 7.87
      }
    },
    "net_tax_payable": {
      "pattern": "Net tax payable\\s*4\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Net tax payable amount",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 506.59,
        "width": 63.12,
        "height": 7.87
      }
    },
    "interest_and_fee": {
      "pattern": "Interest and Fee Payable\\s*5\\s*(\\d+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Interest and fee payable",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 482.4,
        "width": 98.77,
        "height": 7.87
      }
    },
    "total_tax_payable": {
      "pattern": "Total tax, interest and Fee payable\\s*6\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Total tax, interest and fee payable",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 579.16,
        "width": 51.5,
        "height": 7.87
      }
    },
    "taxes_paid": {
      "pattern": "Taxes Paid\\s*7\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Total taxes already paid",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 434.02,
        "width": 42.75,
        "height": 7.87
      }
    },
    "refund_or_payable": {
      "pattern": "\\(\\+\\) Tax Payable /\\(-\\) Refundable \\(6-7\\)\\s*8\\s*\\((-)?\\)\\s*([\\d,]+)",
      "type": "regex",
      "group": 2,
      "transform": "refund",
      "signGroup": 1,
      "description": "Tax payable or refundable amount",
      "coordinates": {
        "page": 1,
        "x": 101.57,
        "y": 781.56,
        "width": 309.54,
        "height": 10.74
      }
    },
    "transmission_date": {
      "pattern": "electronically transmitted on\\s+([\\d]{2}-[A-Za-z]{3}-[\\d]{4}\\s+[\\d:]+)",
      "type": "regex",
      "group": 1,
      "description": "Date and time of electronic transmission",
      "coordinates": {
        "page": 1,
        "x": 44.65,
        "y": 238.38,
        "width": 191.22,
        "height": 7.87
      }
    },
    "ip_address": {
      "pattern": "from IP address\\s+([\\d\\.]+)",
      "type": "regex",
      "group": 1,
      "description": "IP address from which return was filed",
      "coordinates": {
        "page": 1,
        "x": 376.61,
        "y": 238.38,
        "width": 61.73,
        "height": 7.87
      }
    },
    "verified_by": {
      "pattern": "verified by\\s+([A-Za-z\\s]+?)\\s+having PAN",
      "type": "regex",
      "group": 1,
      "description": "Name of person who verified",
      "coordinates": {
        "page": 1,
        "x": 224.53,
        "y": 759.57,
        "width": 70.11,
        "height": 7.87
      }
    },
    "verified_by_pan": {
      "pattern": "having PAN\\s+([A-Z\\d]+)",
      "type": "regex",
      "group": 1,
      "description": "PAN of person who verified the return",
      "coordinates": {
        "page": 1,
        "x": 328.61,
        "y": 223.96,
        "width": 45.14,
        "height": 7.87
      }
    },
    "verification_date": {
      "pattern": "on\\s+([\\d]{2}-[A-Za-z]{3}-[\\s\\n]*[\\d]{4})",
      "type": "regex",
      "group": 1,
      "description": "Date of verification",
      "coordinates": {
        "page": 1,
        "x": 417.3,
        "y": 812.03,
        "width": 150.5,
        "height": 9.6
      }
    },
    "verification_method": {
      "pattern": "([A-Za-z]+\\s+OTP)\\s+mode",
      "type": "regex",
      "group": 1,
      "description": "Method used for verification",
      "coordinates": {
        "page": 1,
        "x": 67.88,
        "y": 195.16,
        "width": 51.61,
        "height": 7.87
      }
    },
    "verification_code": {
      "pattern": "Electronic Verification Code\\s+([A-Z\\d]+)",
      "type": "regex",
      "group": 1,
      "description": "Electronic verification code"
    },
    "barcode": {
      "pattern": "Barcode/QR Code\\s+([A-Za-z0-9]+)",
      "type": "regex",
      "group": 1,
      "description": "Barcode or QR code identifier",
      "coordinates": {
        "page": 1,
        "x": 60.01,
        "y": 145.07,
        "width": 69.92,
        "height": 7.87
      }
    },
    "accrued_income_115td": {
      "pattern": "Accrued.*?section.*?115.*?9\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Accrued Income as per section 115TD (field 9)"
    },
    "additional_tax_115td": {
      "pattern": "Additional Tax payable u/s 115TD\\s*10\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Additional Tax payable under section 115TD (field 10)",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 361.45,
        "width": 133.81,
        "height": 7.87
      }
    },
    "interest_payable_115te": {
      "pattern": "Interest payable u/s 115TE\\s*11\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Interest payable under section 115TE (field 11)",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 482.4,
        "width": 98.77,
        "height": 7.87
      }
    },
    "additional_tax_interest": {
      "pattern": "Additional Tax and interest payable\\s*12\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Additional Tax and interest payable (field 12)",
      "coordinates": {
        "page": 1,
        "x": 69.8,
        "y": 361.45,
        "width": 133.81,
        "height": 7.87
      }
    },
    "tax_interest_paid": {
      "pattern": "Tax and interest paid\\s*13\\s*([\\d,]+)",
      "type": "regex",
      "group": 1,
      "transform": "number",
      "description": "Tax and interest paid (field 13)",
      "coordinates": {
        "page": 1,
        "x": 101.57,
        "y": 781.56,
        "width": 309.54,
        "height": 10.74
      }
    },
    "refund_payable_12_13": {
      "pattern": "Tax Payable.*?Refundable.*?\\(12-13\\)\\s*14\\s*\\(?(-)?\\)?\\s*([\\d,]+)",
      "type": "regex",
      "group": 2,
      "transform": "refund",
      "signGroup": 1,
      "description": "Tax Payable or Refundable (12-13) (field 14)",
      "coordinates": {
        "page": 1,
        "x": 101.57,
        "y": 781.56,
        "width": 309.54,
        "height": 10.74
      }
    }
  },
  "output_format": {
    "sections": [
      {
        "name": "Basic Details",
        "fields": [
          "acknowledgement_number",
          "filing_date",
          "assessment_year",
          "form_number",
          "efiling_ack_number",
          "barcode"
        ]
      },
      {
        "name": "Personal Information",
        "fields": [
          "pan",
          "name",
          "address",
          "status"
        ]
      },
      {
        "name": "Filing Details",
        "fields": [
          "filed_under_section",
          "transmission_date",
          "ip_address",
          "verified_by",
          "verified_by_pan",
          "verification_date",
          "verification_method",
          "verification_code"
        ]
      },
      {
        "name": "Tax Details - Income",
        "fields": [
          "current_year_loss",
          "total_income",
          "book_profit",
          "adjusted_income"
        ]
      },
      {
        "name": "Tax Details - Payment",
        "fields": [
          "net_tax_payable",
          "interest_and_fee",
          "total_tax_payable",
          "taxes_paid",
          "refund_or_payable"
        ]
      },
      {
        "name": "Accrued Income and Tax Detail",
        "fields": [
          "accrued_income_115td",
          "additional_tax_115td",
          "interest_payable_115te",
          "additional_tax_interest",
          "tax_interest_paid",
          "refund_payable_12_13"
        ]
      }
    ]
  }
}